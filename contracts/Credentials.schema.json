{
  "additionalProperties": false,
  "properties": {
    "username": {
      "pattern": "^[A-Za-z0-9_]{3,32}$",
      "title": "Username",
      "type": "string"
    },
    "password": {
      "maxLength": 128,
      "minLength": 10,
      "title": "Password",
      "type": "string"
    },
    "captcha_id": {
      "anyOf": [
        {
          "pattern": "^[a-f0-9]{32}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Captcha Id"
    },
    "captcha_answer": {
      "anyOf": [
        {
          "maxLength": 10,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Captcha Answer"
    }
  },
  "required": [
    "username",
    "password"
  ],
  "title": "Credentials",
  "type": "object"
}
