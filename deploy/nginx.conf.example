# Add these servers to the existing Nginx installation, after setting the real paths.
server {
    listen 80;
    server_name ctx.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name ctx.example.com;
    ssl_certificate /etc/nginx/certs/ctx/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/ctx/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    root /var/www/ctx/current;
    index index.html;
    client_max_body_size 2m;
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy same-origin always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; font-src 'self' data:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;

    location /api/ {
        # Shared Docker network: replace with http://ctx-api:8000 .
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Overwrite client-supplied forwarding headers; exactly one trusted proxy hop.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Connection "";
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
        proxy_send_timeout 30s;
        error_page 413 = @api_too_large;
    }
    location @api_too_large {
        default_type application/json;
        return 413 '{"error":{"code":"request_too_large","message":"请求不能超过 2 MiB","details":null,"request_id":"$request_id"}}';
    }
    location /assets/ {
        expires 1y;
        try_files $uri =404;
    }
    location / {
        try_files $uri $uri/ /index.html;
        expires -1;
    }
}
