# Copy to .env before production. Values below are examples, never deploy as-is.
CTX_ENV=production
SECRET_KEY=replace-with-at-least-32-random-characters
DATABASE_URL=mysql+pymysql://ctx_user:replace-password@host.docker.internal:3306/ctx?charset=utf8mb4
PUBLIC_URL=https://ctx.example.com
TRUSTED_HOSTS=ctx.example.com
PROXY_HOPS=1
API_BIND=127.0.0.1
API_PORT=8000
WEB_WORKERS=2
DB_POOL_SIZE=5
CTX_SHARED_NETWORK=ctx-shared
